<view class="page">
  <view class="header">
    <view class="header-title">校服寻找工具</view>
    <view class="header-subtitle">轻松找回你的校服</view>
  </view>

  <view class="action-bar">
    <button class="action-btn my-uniform-btn" bindtap="goToMyUniform">
      <image class="action-icon" src="/images/icon_my_uniform.png" mode="aspectFit" />
      <text class="action-text">我的校服</text>
    </button>
    <button class="action-btn add-btn" bindtap="goToScanAdd">
      <image class="action-icon" src="/images/icon_add.png" mode="aspectFit" />
      <text class="action-text">添加校服</text>
    </button>
    <button class="action-btn report-btn" bindtap="goToScanReport">
      <image class="action-icon" src="/images/icon_report.png" mode="aspectFit" />
      <text class="action-text">报告丢失</text>
    </button>
    <button class="action-btn settings-btn" bindtap="goToSettings">
      <image class="action-icon" src="/images/icon_settings.png" mode="aspectFit" />
      <text class="action-text">设置</text>
    </button>
  </view>

  <view class="section-title">
    <text class="section-title-text">消息通知</text>
    <button class="refresh-btn" bindtap="onRefresh">
      <image class="refresh-icon" src="/images/icon_refresh.png" mode="aspectFit" />
    </button>
  </view>

  <view class="message-list" wx:if="{{messageList.length > 0}}">
    <view class="message-item" wx:for="{{messageList}}" wx:key="timeId" data-timeid="{{item.timeId}}">
      <view class="message-header">
        <view class="message-type {{'type-' + item.type}}">
          <text wx:if="{{item.type === 1}}">丢失通知</text>
          <text wx:elif="{{item.type === 2}}">已领取通知</text>
          <text wx:elif="{{item.type === 3}}">激活通知</text>
          <text wx:elif="{{item.type === 4}}">删除通知</text>
        </view>
        <view class="message-time">{{item.time}}</view>
      </view>
      <view class="message-body">
        <view class="message-detail">
          <text class="detail-label">YID：</text>
          <text class="detail-value">{{item.detail.yid}}</text>
        </view>
        <view class="message-detail">
          <text class="detail-label">学校：</text>
          <text class="detail-value">{{item.detail.name}}</text>
        </view>
      </view>
      <view class="message-footer">
        <text class="auto-delete-tag" wx:if="{{item.auto_delete}}">15天后自动删除</text>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <image class="empty-icon" src="/images/icon_scan.png" mode="aspectFit" />
    <text class="empty-text">暂无消息通知</text>
    <text class="empty-hint">扫码添加校服后，消息将显示在这里</text>
  </view>
</view>