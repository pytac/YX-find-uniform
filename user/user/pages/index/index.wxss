.page {
  min-height: 100vh;
  padding-bottom: 30rpx;
}

.header {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  padding: 40rpx 30rpx 50rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 10rpx;
}

.action-bar {
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 30rpx 20rpx;
  background: #fff;
  margin: -30rpx 20rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08);
  position: relative;
  z-index: 10;
  flex-wrap: wrap;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 10rpx;
  border: none;
  background: transparent;
  border-radius: 16rpx;
  min-width: 120rpx;
  min-height: auto;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 22rpx;
  color: #333;
  font-weight: 500;
}

.my-uniform-btn .action-icon {
  background: #5C6BC0;
  border-radius: 50%;
  padding: 8rpx;
}

.add-btn .action-icon {
  background: #4CAF50;
  border-radius: 50%;
  padding: 8rpx;
}

.report-btn .action-icon {
  background: #FF9800;
  border-radius: 50%;
  padding: 8rpx;
}

.settings-btn .action-icon {
  background: #78909C;
  border-radius: 50%;
  padding: 8rpx;
}

.section-title {
  padding: 40rpx 30rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  position: relative;
  padding-left: 20rpx;
}

.section-title-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 6rpx;
  height: 28rpx;
  background: #4CAF50;
  border-radius: 3rpx;
}

.refresh-btn {
  width: 56rpx;
  height: 56rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.refresh-btn::after {
  border: none;
}

.refresh-btn:active {
  background: #C8E6C9;
}

.refresh-icon {
  width: 32rpx;
  height: 32rpx;
}

.message-list {
  padding: 0 20rpx 20rpx;
}

.message-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.message-type {
  font-size: 24rpx;
  font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.type-1 {
  background: #FFF3E0;
  color: #E65100;
}

.type-2 {
  background: #E8F5E9;
  color: #2E7D32;
}

.type-3 {
  background: #E3F2FD;
  color: #1565C0;
}

.type-4 {
  background: #FBE9E7;
  color: #BF360C;
}

.message-time {
  font-size: 22rpx;
  color: #999;
}

.message-body {
  background: #FAFAFA;
  border-radius: 12rpx;
  padding: 16rpx;
}

.message-detail {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.message-detail:last-child {
  margin-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
  width: 80rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.message-footer {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.auto-delete-tag {
  font-size: 20rpx;
  color: #999;
  background: #F5F5F5;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.action-buttons {
  display: flex;
  gap: 12rpx;
}

.action-icon-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border: none;
  border-radius: 30rpx;
  min-width: auto;
  min-height: auto;
  line-height: 1;
  font-size: 22rpx;
}

.action-icon-btn::after {
  border: none;
}

.delete-btn {
  background: #F5F5F5;
  color: #999;
}

.delete-btn:active {
  background: #EEEEEE;
}

.scan-btn {
  background: #E8F5E9;
  color: #4CAF50;
}

.scan-btn:active {
  background: #C8E6C9;
}

.action-icon-small {
  width: 32rpx;
  height: 32rpx;
}

.action-icon-text {
  font-size: 22rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
}