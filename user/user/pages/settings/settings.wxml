<view class="page">
  <view class="settings-header">
    <view class="settings-title">设置</view>
    <view class="settings-subtitle">配置服务器信息</view>
  </view>

  <view class="settings-card">
    <view class="form-group">
      <view class="form-label">用户UID</view>
      <view class="form-readonly">
        <text class="form-readonly-text" user-select="{{true}}">{{uid || '未生成'}}</text>
      </view>
      <view class="form-hint">由系统自动生成的唯一标识，仅可查看</view>
    </view>

    <view class="form-group">
      <view class="form-label">服务器地址</view>
      <view class="form-input-wrapper">
        <input class="form-input" type="text" placeholder="请输入服务器地址" value="{{serverUrl}}" bindinput="onUrlInput" />
      </view>
      <view class="form-hint">默认值：http://127.0.0.1:5000</view>
    </view>

    <button class="save-btn" bindtap="saveSettings">
      <text>保存设置</text>
    </button>
  </view>

  <view class="settings-info">
    <text class="info-text">校服寻找工具 v1.0.0（测试版）</text>
  </view>

  <view class="settings-footer">
    <view class="footer-line">项目地址: https://github.com/pytac/YX-find-uniform</view>
    <view class="footer-line">开源协议: PolyForm-Noncommercial-1.0.0</view>
    <view class="footer-line">(c) 2026 Pytac, All Rights Reserved.</view>
  </view>
</view>