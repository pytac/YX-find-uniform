.page {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  padding: 60rpx 0 40rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

.card {
  width: 100%;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}

.card-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.card-value {
  font-size: 28rpx;
  color: #4CAF50;
  background: #f5f5f5;
  padding: 20rpx;
  border-radius: 12rpx;
  font-weight: 600;
  word-break: break-all;
}

.input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.hint {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 12rpx;
}

.actions {
  margin-top: 60rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #4CAF50;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 80rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 30rpx rgba(76,175,80,0.4);
  border: none;
  width: 100%;
}

.submit-btn::after {
  border: none;
}