.page {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 30rpx;
}

.header {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  padding: 40rpx 30rpx 50rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 10rpx;
}

.uniform-list {
  padding: 20rpx;
}

.uniform-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
}

.uniform-icon {
  width: 80rpx;
  height: 80rpx;
  background: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.uniform-icon image {
  width: 48rpx;
  height: 48rpx;
}

.uniform-info {
  flex: 1;
  min-width: 0;
}

.list-tip {
  font-size: 24rpx;
  color: #888;
  padding: 8rpx 8rpx 16rpx;
}

/* 有校服被学校删除时的提醒 */
.list-tip.warn {
  color: #E8890C;
  padding: 0 8rpx 16rpx;
}

/* 已被学校删除 / 服务器上查不到：整条淡化，避免误以为是还能用的校服 */
.uniform-item.is-deleted {
  background: #FAFAFA;
  border: 2rpx dashed #E0E0E0;
  box-shadow: none;
}

.uniform-item.is-deleted .uniform-yid {
  color: #888;
}

.uniform-status {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.status-tag {
  font-size: 20rpx;
  line-height: 1.6;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}

.status-tag.deleted {
  color: #E53935;
  background: #FFEBEE;
}

.status-tag.missing {
  color: #E8890C;
  background: #FFF4E5;
}

.status-time {
  font-size: 20rpx;
  color: #AAA;
}

/* 移除按钮 */
.uniform-remove {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  border: 2rpx solid #E53935;
  color: #E53935;
  font-size: 24rpx;
  line-height: 1.3;
}

.uniform-remove-hover {
  background: #FFEBEE;
}


.uniform-yid {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
  /* YID 是 36 位 UUID，必须允许任意位置换行 */
  word-break: break-all;
}

.uniform-student {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.uniform-school {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.uniform-time {
  font-size: 22rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 150rpx 40rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
}