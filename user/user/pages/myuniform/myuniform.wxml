<view class="page">
  <view class="header">
    <view class="header-title">我的校服</view>
    <view class="header-subtitle">查看已绑定的校服信息</view>
  </view>

  <view class="uniform-list" wx:if="{{uniformList.length > 0}}">
    <view class="uniform-item" wx:for="{{uniformList}}" wx:key="yid">
      <view class="uniform-icon">
        <image src="/images/icon_my_uniform.png" mode="aspectFit" />
      </view>
      <view class="uniform-info">
        <view class="uniform-yid">YID：{{item.yid}}</view>
        <view class="uniform-student">学号：{{item.student}}</view>
        <view class="uniform-time">绑定时间：{{item.time}}</view>
      </view>
    </view>
  </view>

  <view class="empty-state" wx:else>
    <image class="empty-icon" src="/images/icon_my_uniform.png" mode="aspectFit" />
    <text class="empty-text">还没有绑定校服</text>
    <text class="empty-hint">去首页扫码添加校服吧！</text>
  </view>
</view>